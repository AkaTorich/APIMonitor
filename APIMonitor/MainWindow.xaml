<Window x:Class="APIMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:APIMonitor.ViewModel"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="APIMonitor"
        Height="720" Width="1280"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        FontFamily="Cascadia Mono, Consolas"
        FontSize="12"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="28"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Maximize fits the monitor work area exactly (WM_GETMINMAXINFO in
         code-behind), so no margin compensation is needed. -->
    <Border BorderBrush="#FFFF00" BorderThickness="1">
    <DockPanel LastChildFill="True">

        <!-- Custom title bar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Height="28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: prompt-like title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <TextBlock Text="[ "      Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                    <TextBlock Text="apimon"  Foreground="{StaticResource FgBrush}"     FontWeight="Bold">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="6" Color="#33FF99" Opacity="0.9"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text=" @ "     Foreground="{StaticResource DimBrush}"/>
                    <TextBlock Text="win32"   Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text=" ]"      Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                    <TextBlock Text=" :: "    Foreground="{StaticResource DimBrush}"/>
                    <TextBlock Text="API tracer" Foreground="{StaticResource DimBrush}"/>
                </StackPanel>

                <!-- Right: window controls (min, max, close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Stretch"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinButton"
                            Width="40" MinWidth="0"
                            BorderThickness="0,0,1,0"
                            Padding="0"
                            Click="MinButton_Click">
                        <Image Source="{StaticResource IconMin}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="MaxButton"
                            Width="40" MinWidth="0"
                            BorderThickness="0,0,1,0"
                            Padding="0"
                            Click="MaxButton_Click">
                        <Image Source="{StaticResource IconMax}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="CloseButton"
                            Width="40" MinWidth="0"
                            BorderThickness="0"
                            Padding="0"
                            Click="CloseButton_Click">
                        <Image Source="{StaticResource IconClose}" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Top bar: target path, browse, run/stop, filter -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8">
          <StackPanel Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Target .exe:" VerticalAlignment="Center"/>
                <TextBox  Grid.Column="1"
                          Margin="6,0,6,0"
                          VerticalContentAlignment="Center"
                          Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding CanEditTarget}"/>
                <Button Grid.Column="2"
                        Margin="0,0,6,0"
                        Command="{Binding BrowseCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource IconOpen}" Width="14" Height="14" Margin="0,0,6,0" Stretch="Uniform"/>
                        <TextBlock Text="Browse..." VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Margin="0,0,12,0"
                        Command="{Binding RunStopCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource IconRun}" Width="14" Height="14" Margin="0,0,6,0" Stretch="Uniform"/>
                        <TextBlock Text="{Binding RunStopText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Label Grid.Column="4" Content="Filter:" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="5"
                          Width="120"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding SelectedFilter}"/>
                <Button Grid.Column="6"
                        Margin="6,0,0,0"
                        Command="{Binding ClearCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource IconTrash}" Width="14" Height="14" Margin="0,0,6,0" Stretch="Uniform"/>
                        <TextBlock Text="Clear" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Label Grid.Column="7" Content="Search:" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBox Grid.Column="8"
                         Width="220"
                         Margin="6,0,0,0"
                         VerticalContentAlignment="Center"
                         ToolTip="Filter rows by Function / Args / Ret (case-insensitive)"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <!-- Remote relay row -->
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <CheckBox Content="Remote"
                          VerticalAlignment="Center"
                          Foreground="{StaticResource AccentBrush}"
                          FontWeight="Bold"
                          IsChecked="{Binding RemoteEnabled}"
                          ToolTip="Launch &amp; monitor on a remote machine via ApimonRelay. Target .exe path above is then the path ON THE REMOTE machine."/>
                <Label Content="Host:" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBox Width="140" Margin="6,0,0,0" VerticalContentAlignment="Center"
                         IsEnabled="{Binding RemoteEnabled}"
                         Text="{Binding RemoteHost, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Port:" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBox Width="70" Margin="6,0,0,0" VerticalContentAlignment="Center"
                         IsEnabled="{Binding RemoteEnabled}"
                         Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Margin="12,0,0,0"
                        IsEnabled="{Binding RemoteEnabled}"
                        Command="{Binding BrowseRemoteCommand}"
                        ToolTip="Browse the remote machine's filesystem and pick a .exe">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource IconFolder}" Width="14" Height="14" Margin="0,0,6,0" Stretch="Uniform"/>
                        <TextBlock Text="Browse VM..." VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7"
                           Text="(run ApimonRelay.exe elevated on the remote machine first)"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Height="24">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Events: "/>
                    <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                    <Run Text="  Visible: "/>
                    <Run Text="{Binding VisibleCount, Mode=OneWay}"/>
                    <Run Text="  Dropped: "/>
                    <Run Text="{Binding DroppedCount, Mode=OneWay}"/>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding DriverStatus}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main grid with events -->
        <DataGrid ItemsSource="{Binding VisibleEvents}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  RowHeight="18"
                  Background="{StaticResource BgBrush}"
                  Foreground="{StaticResource FgBrush}"
                  BorderThickness="0"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Item"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="Padding" Value="6,2"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{StaticResource BgBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="6,1"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Function" Binding="{Binding Function}"  Width="Auto"/>
                <DataGridTextColumn Header="Args"     Binding="{Binding Args}"      Width="Auto"/>
                <DataGridTextColumn Header="Ret"      Binding="{Binding Ret}"       Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
    </Border>
</Window>
