<Window x:Class="APIMonitor.RemoteBrowseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Remote Browse"
        Height="520" Width="660"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        FontFamily="Cascadia Mono, Consolas"
        FontSize="12"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="28"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#FFFF00" BorderThickness="1">
        <DockPanel LastChildFill="True">

            <!-- Title bar -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Height="28">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="[ "             Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                        <TextBlock Text="remote browse"  Foreground="{StaticResource FgBrush}"     FontWeight="Bold"/>
                        <TextBlock Text=" ]"             Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                        <TextBlock Text=" :: pick a .exe on the VM" Foreground="{StaticResource DimBrush}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Width="40" MinWidth="0" BorderThickness="0" Padding="0" Click="Close_Click">
                            <Image Source="{StaticResource IconClose}" Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom action bar -->
            <Border DockPanel.Dock="Bottom"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Margin="0,0,8,0" Click="Open_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource IconOpen}" Width="14" Height="14" Margin="0,0,6,0" Stretch="Uniform"/>
                            <TextBlock Text="Open" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Cancel_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource IconClose}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform"/>
                            <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Path bar -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Path:" VerticalAlignment="Center"/>
                    <TextBox x:Name="PathBox" Grid.Column="1" Margin="6,0,6,0"
                             IsReadOnly="True" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Click="Up_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource IconUp}" Width="14" Height="14" Margin="0,0,6,0" Stretch="Uniform"/>
                            <TextBlock Text="Up" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Listing -->
            <ListBox x:Name="List"
                     Margin="8"
                     Background="{StaticResource BgBrush}"
                     Foreground="{StaticResource FgBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     DisplayMemberPath="Display"
                     MouseDoubleClick="List_DoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                        <Setter Property="Padding"    Value="4,1"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
                                <Setter Property="Foreground" Value="#020404"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
