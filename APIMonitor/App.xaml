<Application x:Class="APIMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!--
            "y2k cybersec terminal" palette.
            CRT-black background, phosphor green, cyan headers, magenta alerts.
        -->
        <SolidColorBrush x:Key="BgBrush"     Color="#020404"/>
        <SolidColorBrush x:Key="PanelBrush"  Color="#050B08"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#0FAA50"/>
        <SolidColorBrush x:Key="FgBrush"     Color="#33FF99"/>
        <SolidColorBrush x:Key="DimBrush"    Color="#0EAA66"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00FFD0"/>
        <SolidColorBrush x:Key="AlertBrush"  Color="#FF2566"/>

        <!-- Source colours -->
        <SolidColorBrush x:Key="UserApiBrush" Color="#33FF99"/>
        <SolidColorBrush x:Key="UserComBrush" Color="#00FFD0"/>
        <SolidColorBrush x:Key="KernelBrush"  Color="#FFCC33"/>
        <SolidColorBrush x:Key="WeirdBrush"   Color="#FF2566"/>

        <!-- Phosphor "glow" - DropShadow with green colour, no offset -->
        <DropShadowEffect x:Key="PhosphorGlow"
                          ShadowDepth="0"
                          BlurRadius="6"
                          Color="#33FF99"
                          Opacity="0.85"/>
        <DropShadowEffect x:Key="CyanGlow"
                          ShadowDepth="0"
                          BlurRadius="6"
                          Color="#00FFD0"
                          Opacity="0.9"/>

        <!-- Global window style -->
        <Style TargetType="{x:Type Window}">
            <Setter Property="Background"  Value="{StaticResource BgBrush}"/>
            <Setter Property="Foreground"  Value="{StaticResource FgBrush}"/>
            <Setter Property="FontFamily"  Value="Cascadia Mono, Consolas, Courier New, Lucida Console"/>
        </Style>

        <!-- TextBox: input field with a green border + glow on focus -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background"  Value="#020404"/>
            <Setter Property="Foreground"  Value="{StaticResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush"  Value="{StaticResource AccentBrush}"/>
            <Setter Property="Padding"     Value="6,3"/>
            <Setter Property="SelectionBrush" Value="#33FF99"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Effect" Value="{StaticResource CyanGlow}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Button: looks like an ANSI prompt, glows on hover/press -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background"  Value="#020404"/>
            <Setter Property="Foreground"  Value="{StaticResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"     Value="14,4"/>
            <Setter Property="MinWidth"    Value="90"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Effect" Value="{StaticResource PhosphorGlow}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BorderBrush}"/>
                                <Setter Property="Foreground" Value="#020404"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource DimBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox: fully custom template, no system chrome. -->
        <Style x:Key="ComboBoxToggleBtnStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="#020404"/>
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border Grid.Column="1"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1,0,0,0"/>
                            <Path Grid.Column="1"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0,0 L 5,5 L 10,0 Z"
                                  Fill="{StaticResource AccentBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background"  Value="#020404"/>
            <Setter Property="Foreground"  Value="{StaticResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"     Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Style="{StaticResource ComboBoxToggleBtnStyle}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="6,2,24,2"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}"
                                     Visibility="Hidden"
                                     Background="Transparent"
                                     Foreground="{StaticResource FgBrush}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="6,2,24,2"
                                     Focusable="True"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{StaticResource PanelBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"/>
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
            <Setter Property="Padding"    Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BorderBrush}"/>
                                <Setter Property="Foreground" Value="#020404"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar - thin neon bar, square thumb, no arrows. -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="bd"
                                Background="{StaticResource BorderBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="Effect"     Value="{StaticResource CyanGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarPageBtnStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background"  Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Width"  Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageBtnStyle}" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageBtnStyle}" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumbStyle}" MinWidth="20"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageBtnStyle}" Command="ScrollBar.PageUpCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageBtnStyle}" Command="ScrollBar.PageDownCommand"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumbStyle}" MinHeight="20"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Label}">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="{x:Type StatusBar}">
            <Setter Property="Background"  Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground"  Value="{StaticResource DimBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>

        <!-- ============================================================
             Button icons. Native WPF vector resources (DrawingImage),
             hand-translated from the AkaTorich-Icons SVGs in Icons\ - no
             third-party SVG library, no PNG, pure XAML geometry.
             ============================================================ -->

        <!-- run / play (green) -->
        <DrawingImage x:Key="IconRun">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="M2.5,4.2 H7.5 V2.3 L13.2,8 L7.5,13.7 V11.8 H2.5 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0"    Color="#7EE085"/>
                            <GradientStop Offset="0.45" Color="#3EAF3E"/>
                            <GradientStop Offset="1"    Color="#1E7A1E"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen><Pen Brush="#155C15" Thickness="0.55" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- stop (red rounded square) -->
        <DrawingImage x:Key="IconStop">
            <DrawingImage.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="2.5,2.5,19,19" RadiusX="3.5" RadiusY="3.5"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#FF6060"/><GradientStop Offset="1" Color="#AA0000"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- folder (closed, yellow) -->
        <DrawingImage x:Key="IconFolder">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Geometry="M1,7 H23 V20 A2,2 0 0 1 21,22 H3 A2,2 0 0 1 1,20 Z">
                        <GeometryDrawing.Brush><RadialGradientBrush Center="0.35,0.28" GradientOrigin="0.35,0.28" RadiusX="0.65" RadiusY="0.65"><GradientStop Offset="0" Color="#FFE040"/><GradientStop Offset="1" Color="#BB7700"/></RadialGradientBrush></GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M1,10 H23 V20 A2,2 0 0 1 21,22 H3 A2,2 0 0 1 1,20 Z">
                        <GeometryDrawing.Brush><RadialGradientBrush Center="0.35,0.28" GradientOrigin="0.35,0.28" RadiusX="0.65" RadiusY="0.65"><GradientStop Offset="0" Color="#FFCC00"/><GradientStop Offset="1" Color="#FF8800"/></RadialGradientBrush></GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M1,7 V6 A2,2 0 0 1 3,4 H8 L10.5,7 Z">
                        <GeometryDrawing.Brush><RadialGradientBrush Center="0.35,0.28" GradientOrigin="0.35,0.28" RadiusX="0.65" RadiusY="0.65"><GradientStop Offset="0" Color="#FFE040"/><GradientStop Offset="1" Color="#BB7700"/></RadialGradientBrush></GeometryDrawing.Brush>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- open file (folder open) -->
        <DrawingImage x:Key="IconOpen">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Geometry="M1.5,3.5 H6 L7.5,5 H14.5 V13 Q14.5,13.5 14,13.5 H2 Q1.5,13.5 1.5,13 Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#FFE082"/><GradientStop Offset="0.5" Color="#FFB300"/><GradientStop Offset="1" Color="#795500"/>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Pen><Pen Brush="#4A2900" Thickness="0.5" LineJoin="Round"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M2.5,13.5 L4,6.5 H15.5 L14,13.5 Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#FFD54F"/><GradientStop Offset="1" Color="#E65100"/>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Pen><Pen Brush="#4A2900" Thickness="0.5" LineJoin="Round"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- trash (clear) -->
        <DrawingImage x:Key="IconTrash">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="M4,7 H20 M9,7 V5 A1,1 0 0 1 10,4 H14 A1,1 0 0 1 15,5 V7 M5,7 L6,20 A1,1 0 0 0 7,21 H17 A1,1 0 0 0 18,20 L19,7 M10,11 V17 M14,11 V17">
                    <GeometryDrawing.Pen><Pen Brush="#94A3B8" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- close (red X) -->
        <DrawingImage x:Key="IconClose">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="M3,3 L21,21 M21,3 L3,21">
                    <GeometryDrawing.Pen>
                        <Pen Thickness="3.5" StartLineCap="Round" EndLineCap="Round">
                            <Pen.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Offset="0" Color="#FF8080"/><GradientStop Offset="1" Color="#CC0000"/></LinearGradientBrush></Pen.Brush>
                        </Pen>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- nav up (arrow) -->
        <DrawingImage x:Key="IconUp">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <DrawingGroup.Transform><RotateTransform Angle="-90" CenterX="12" CenterY="12"/></DrawingGroup.Transform>
                    <GeometryDrawing Geometry="M7,20 L7,9 Q7,4 12,4 L17,4 M13,8 L17,4 L13,0.5">
                        <GeometryDrawing.Pen><Pen Brush="#94A3B8" Thickness="2.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- minimize -->
        <DrawingImage x:Key="IconMin">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="M22,2 L14,10 L14,2 M2,22 L10,14 L10,22">
                    <GeometryDrawing.Pen>
                        <Pen Thickness="2.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round">
                            <Pen.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Offset="0" Color="#FFE040"/><GradientStop Offset="1" Color="#CC8800"/></LinearGradientBrush></Pen.Brush>
                        </Pen>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- maximize -->
        <DrawingImage x:Key="IconMax">
            <DrawingImage.Drawing>
                <GeometryDrawing Geometry="M14,2 L22,2 L22,10 M22,2 L13,11 M10,22 L2,22 L2,14 M2,22 L11,13">
                    <GeometryDrawing.Pen>
                        <Pen Thickness="2.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round">
                            <Pen.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Offset="0" Color="#70FF88"/><GradientStop Offset="1" Color="#008830"/></LinearGradientBrush></Pen.Brush>
                        </Pen>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Application.Resources>
</Application>
